{
    "version": "0.4.27-2",
    "description": "Discover, download, and run local LLMs",
    "homepage": "https://lmstudio.ai/",
    "license": {
        "identifier": "Proprietary",
        "url": "https://lmstudio.ai/app-terms"
    },
    "architecture": {
        "64bit": {
            "url": "https://installers.lmstudio.ai/win32/x64/0.4.27-2/LM-Studio-0.4.27-2-x64.exe#/dl.7z",
            "hash": "6689fb083d0309692d0b3f8d741ec215098d5c2d2321019bdacc3d1628cff189",
            "installer": {
                "script": [
                    "Remove-Item \"$dir\\*\" -Exclude \"app-64.7z\"",
                    "Expand-7zipArchive \"$dir\\app-64.7z\" \"$dir\"",
                    "Remove-Item \"$dir\\app-64.7z\"",
                    ". \"$bucketsdir\\apeiraco\\bin\\persist-utils.ps1\"",
                    "Set-PersistLinks -PersistDir $persist_dir -LinkMap @{ 'appdata' = '$env:APPDATA\\LM Studio'; 'cache' = '$env:USERPROFILE\\.cache\\lm-studio'; 'userdata' = '$env:USERPROFILE\\.lm-studio' }"
                ]
            }
        },
        "arm64": {
            "url": "https://installers.lmstudio.ai/win32/arm64/0.4.27-2/LM-Studio-0.4.27-2-arm64.exe#/dl.7z",
            "hash": "46dee8139d6d12443c1b9de6c380879269668d8c18285757f7abe15efbf4f6e0",
            "installer": {
                "script": [
                    "Remove-Item \"$dir\\*\" -Exclude \"app-arm64.7z\"",
                    "Expand-7zipArchive \"$dir\\app-arm64.7z\" \"$dir\"",
                    "Remove-Item \"$dir\\app-arm64.7z\"",
                    ". \"$bucketsdir\\apeiraco\\bin\\persist-utils.ps1\"",
                    "Set-PersistLinks -PersistDir $persist_dir -LinkMap @{ 'appdata' = '$env:APPDATA\\LM Studio'; 'cache' = '$env:USERPROFILE\\.cache\\lm-studio'; 'userdata' = '$env:USERPROFILE\\.lm-studio' }"
                ]
            }
        }
    },
    "extract_dir": "$PLUGINSDIR",
    "bin": "resources\\app\\.webpack\\lms.exe",
    "shortcuts": [
        [
            "LM Studio.exe",
            "LM Studio"
        ]
    ],
    "uninstaller": {
        "script": [
            ". \"$bucketsdir\\apeiraco\\bin\\persist-utils.ps1\"",
            "Remove-PersistLinks -PersistDir $persist_dir -LinkMap @{ 'appdata' = '$env:APPDATA\\LM Studio'; 'cache' = '$env:USERPROFILE\\.cache\\lm-studio'; 'userdata' = '$env:USERPROFILE\\.lm-studio' }"
        ]
    },
    "checkver": {
        "url": "https://lmstudio.ai/download",
        "regex": "\\\\\"version\\\\\":\\\\\"(?<ver>[\\d.]+)\\\\\",\\\\\"build\\\\\":\\\\\"(?<build>\\d+)\\\\\"",
        "replace": "${ver}-${build}"
    },
    "autoupdate": {
        "architecture": {
            "64bit": {
                "url": "https://installers.lmstudio.ai/win32/x64/$version/LM-Studio-$version-x64.exe#/dl.7z"
            },
            "arm64": {
                "url": "https://installers.lmstudio.ai/win32/arm64/$version/LM-Studio-$version-arm64.exe#/dl.7z"
            }
        }
    }
}
